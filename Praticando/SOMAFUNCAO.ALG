algoritmo "somafuncao"
var
   v1, v2, s : inteiro

funcao soma(a,b : inteiro) :inteiro
inicio
    retorne a + b

FimFuncao
inicio
      escreva("informe o primeiro valor: ")
      leia(v1)
      escreva("informe o segundo valor: ")
      leia(v2)

      s <- soma(v1, v2)

      escreva("A soma é: ", s)


fimalgoritmo